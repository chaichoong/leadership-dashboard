#!/usr/bin/env python3
"""
Local pre-commit hook — delegates to the shared script.
Install: ln -sf ../../scripts/pre-commit .git/hooks/pre-commit
"""
import os
import subprocess
import sys

# realpath, NOT abspath. This file is INSTALLED AS A SYMLINK at
# .git/hooks/pre-commit, and abspath does not follow symlinks — it resolved to
# .git/hooks, the lookup below missed, the `else` branch exited 0, and the hook
# did nothing on every commit while looking perfectly installed.
# Found 2026-08-06 by installing it and watching pageVer refuse to move.
script_dir = os.path.dirname(os.path.realpath(__file__))
shared_script = os.path.join(script_dir, 'pre-commit-action.py')
guard_script = os.path.join(script_dir, 'private-name-guard.py')

# The commit-message half of the name guard lives in its own hook
# (scripts/commit-msg, 29 Sep 2026). Say so when it is not installed, because a
# missing hook checks nothing and says nothing. A warning only, never a block.
try:
    common = subprocess.run(['git', 'rev-parse', '--git-common-dir'], capture_output=True,
                            text=True, cwd=os.getcwd()).stdout.strip()
    if common and not os.path.exists(os.path.join(common, 'hooks', 'commit-msg')):
        print("⚠️  commit-msg hook not installed, so commit messages are NOT checked for private names. "
              "Install: ln -sf ../../scripts/commit-msg .git/hooks/commit-msg", file=sys.stderr)
except OSError as e:
    print(f"⚠️  pre-commit hook: could not check for the commit-msg hook: {e}", file=sys.stderr)

# The private-name guard runs FIRST and is the only step here allowed to block:
# this repo is PUBLIC, and a staged line naming someone on the private roster
# must never reach it. See scripts/private-name-guard.py.
if os.path.exists(guard_script):
    guard = subprocess.run([sys.executable, guard_script], cwd=os.getcwd())
    if guard.returncode != 0:
        sys.exit(guard.returncode)
else:
    print(f"⚠️  pre-commit hook: {guard_script} not found — private names NOT checked.",
          file=sys.stderr)

if not os.path.exists(shared_script):
    # Do not exit 0 quietly. A missing sibling means a broken install, and a
    # silent success is exactly what hid the bug above. Warn loudly, but do not
    # block: a version bump is never worth losing someone's commit over.
    print(f"⚠️  pre-commit hook: {shared_script} not found — pageVer NOT bumped.",
          file=sys.stderr)
    sys.exit(0)

result = subprocess.run([sys.executable, shared_script], cwd=os.getcwd())
sys.exit(result.returncode)
