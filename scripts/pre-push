#!/usr/bin/env bash
# Pre-push hook — runs the test suites before pushing to main.
# Install: ln -sf ../../scripts/pre-push .git/hooks/pre-push
#
# Two suites, cheapest first:
#   1. vitest  (tests/*.test.js)            — ~1s, pure Node, no browser
#   2. playwright (tests/sync-invariants/)  — ~1-2min, boots a server and Chromium
#
# vitest was added to this gate on 2026-08-01. Until then NOTHING ran it — not this
# hook, not any workflow in .github/workflows/ — so every guard in it was dormant
# unless somebody happened to type `npm test`. That included the money-daily-worker
# drift check, which protects the "Safe to act today" figure Kevin spends against.
# A test nobody runs is a comment.
#
# Skips if:
#   - Not pushing to main
#   - SKIP_SYNC_TESTS=1 is set (escape hatch — skips BOTH suites)
#
# A MISSING RUNNER BLOCKS THE PUSH (24 Aug 2026 — finding 20260822-ceo-memory-sweep-318)
# --------------------------------------------------------------------------------------
# Until today an absent node_modules turned this gate into a pass: a missing
# vitest printed a warning and carried on, and a missing @playwright printed a
# warning and `exit 0`. Two pushes to main on 21 Aug ran the SAME gate in the
# SAME checkout with different outcomes — the first ran no tests at all, the
# second ran 211. Nothing recorded which was which.
#
# That is SKIP_SYNC_TESTS=1 without anyone having to type it, and it is worse
# than the escape hatch: the escape hatch is a deliberate act that shows up in
# the shell history. So a missing runner now FAILS. `npm install` is the fix and
# it takes seconds; if the push genuinely must go out untested, type the escape
# hatch and own it.
#
# EVERY DECISION IS LOGGED. The log lives outside the repo (this repo is public)
# at ~/knowledge-os/logs/pre-push-gate.log, so "did the gate actually run before
# that push" is a question with an answer.

set -e

# GIT'S OWN ENVIRONMENT STOPS HERE (2 Oct 2026)
# ---------------------------------------------
# Git hands a hook its own variables so the hook's git commands find the
# repository: for a push from a linked worktree that is GIT_DIR, as a full path
# (from the main checkout there is no GIT_DIR, which is why this stayed hidden).
# Everything the hook starts inherits them, and the unit tests
# build throwaway repositories in temp folders with `git init`, `git config`,
# `git commit` and `git push`. With GIT_DIR set, every one of those ran against
# THIS repository instead. On 2 Oct 2026 a push to main from a worktree left the
# shared config reading `bare = true` with hooks switched off and a test identity,
# moved the branch and HEAD on to fixture commits, and pushed a fixture branch
# (`feature/x`) to GitHub. 110 tests failed, which is the only reason the push
# stopped; every worktree and robot had no working git until it was repaired.
# Cleared here, so nothing below can inherit them. Git finds the repository from
# the working directory, which is where git starts a hook. tests/setup-git-env.js
# clears the same variables inside vitest, for a run started from any other hook.
# Guarded by tests/push-gate-git-env.test.js.
# Fails closed: if git cannot list them, the gate does not run with them still set.
git_local_env=$(git rev-parse --local-env-vars) || { echo "❌ Could not list git's own environment variables, so the test gate will not run with them set. Push blocked."; exit 1; }
unset $git_local_env
# The numbered pairs GIT_CONFIG_COUNT announces are not on git's list; they go too.
unset $(compgen -v | grep -E '^GIT_CONFIG_(KEY|VALUE)_[0-9]+$' || true)

GATE_LOG="${GATE_LOG:-$HOME/knowledge-os/logs/pre-push-gate.log}"
mkdir -p "$(dirname "$GATE_LOG")" 2>/dev/null || true

gate_log() {
    printf '%s\t%s\t%s\t%s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(git rev-parse --short HEAD 2>/dev/null || echo unknown)" \
        "$1" "$2" >> "$GATE_LOG" 2>/dev/null || true
}

if [ "$SKIP_SYNC_TESTS" = "1" ]; then
    gate_log BYPASSED "SKIP_SYNC_TESTS=1"
    exit 0
fi

# Only gate pushes to main
remote="$1"
while read local_ref local_sha remote_ref remote_sha; do
    if echo "$remote_ref" | grep -q "refs/heads/main"; then
        if ! command -v npx >/dev/null 2>&1; then
            echo "❌ npx not found — cannot run the test gate, so this push to main is blocked."
            echo "   Install Node, or use SKIP_SYNC_TESTS=1 git push to bypass deliberately."
            gate_log BLOCKED "npx missing"
            exit 1
        fi

        # ── Unit tests first: they take about a second, so a failure here costs
        # nothing, whereas letting Playwright run first burns ~2 minutes before
        # reporting a break that vitest would have caught immediately.
        if [ ! -d "node_modules/vitest" ]; then
            echo "❌ vitest is not installed — the unit-test gate cannot run, so this push to main is blocked."
            echo "   Run 'npm install' (seconds), then push again."
            echo "   A missing runner used to warn and carry on, which is how two"
            echo "   pushes on 21 Aug 2026 ran the same gate with different outcomes."
            gate_log BLOCKED "node_modules/vitest missing"
            exit 1
        fi
        echo "🧪 Running unit tests (vitest) before push to main..."
        if npx vitest run --reporter=dot; then
            echo "✅ Unit tests passed"
        else
            echo ""
            echo "❌ Unit tests (vitest) FAILED — push to main blocked."
            echo "   Fix the failing tests or use SKIP_SYNC_TESTS=1 git push to bypass."
            gate_log FAILED vitest
            exit 1
        fi

        if [ ! -d "node_modules/@playwright" ]; then
            echo "❌ Playwright is not installed — the sync-invariant gate cannot run, so this push to main is blocked."
            echo "   Run 'npm install', then push again."
            gate_log BLOCKED "node_modules/@playwright missing"
            exit 1
        fi

        echo "🧪 Running sync-invariant tests before push to main..."
        if npx playwright test tests/sync-invariants/ --reporter=dot --workers=2; then
            echo "✅ All sync-invariant tests passed"
            gate_log RAN "vitest + playwright"
        else
            echo ""
            echo "❌ Sync-invariant tests FAILED — push to main blocked."
            echo "   Fix the failing tests or use SKIP_SYNC_TESTS=1 git push to bypass."
            gate_log FAILED playwright
            exit 1
        fi
    fi
done

exit 0
