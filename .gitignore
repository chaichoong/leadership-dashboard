node_modules
test-results/
playwright-report/

# Secrets — NEVER commit. This repo is PUBLIC (GitHub Pages at
# chaichoong.github.io/leadership-dashboard). A leaked Airtable PAT is
# read/write on the whole business base.
# .e2e_tok appeared untracked and unignored on 16 Jul 2026 containing a
# byte-identical copy of ~/.config/od/airtable_pat. One `git add -A` from
# publication. The source of truth is ~/.config/od/airtable_pat — nothing
# should ever copy a live token into the working tree.
.e2e_tok
*.tok
*_tok
.env
.env.*
*.pat
airtable_pat

# Build-verification screenshots — artifacts, and this repo is PUBLIC.
.claude/shots/

# Agent scratch output — dispatch queues, board dumps, close-out notes, triage
# runs. Written to the working tree by the dispatch/task-manager/triage jobs and
# never meant to be committed. 129 of them had accumulated by 31 Aug 2026, oldest
# 27 Aug at the repo root plus 8 more in scripts/. They contain live business data
# (creditor matters, task bodies, HMRC working files) and this repo is PUBLIC, so
# one `git add -A` would publish them. Ignoring is safer than leaving them
# visible-but-uncommitted. Deliberately NOT anchored with a leading slash: agents
# drop this scratch in subdirectories too, so the pattern must match at any depth.
_tmp_*
_tm_*
_triage_*
_dispatch_*
